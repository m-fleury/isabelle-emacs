unsat
(assume nst3.0 (not (= (bvand x y z (bvnot y) w) (@bv 0 4))))
(assume t2 (= 4 (@bvsize y)))
(step st3 (cl (= (bvand x y z (bvnot y) w) (@bv 0 4))) :rule rare_rewrite :premises (t2) :args ("bv-and-simplify-2" (rare-list x) (rare-list z) (rare-list w) y 4))
(step t.end (cl) :rule resolution :premises (nst3.0 st3))
