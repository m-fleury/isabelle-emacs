(set-logic QF_NIRA)
(declare-fun pi () Real)
(declare-fun y () Real)
(declare-fun s () Int)
(declare-fun z () Real)
(assert (not (not (ite (>= s 0) (ite (>= 1 0) (> s 1) (> s (- 1))) (ite (>= 1 0) (> (- s) 1) (> (- s) (- 1)))))))
(assert (not (not (not (= pi 0.0)))))
(assert (not (not (not (= s 0)))))
(assert (not (ite (>= (* pi (to_real s)) 0.0) (ite (>= pi 0.0) (> (* pi (to_real s)) pi) (> (* pi (to_real s)) (- pi))) (ite (>= pi 0.0) (> (- (* pi (to_real s))) pi) (> (- (* pi (to_real s))) (- pi))))))
(check-sat)
(exit)
