(set-logic ALL)
(declare-sort $$unsorted 0)
(declare-sort tptp.list 0)
(declare-fun tptp.nil () tptp.list)
(declare-fun tptp.mycons (Int tptp.list) tptp.list)
(declare-fun tptp.fib_sorted (tptp.list) Bool)
(assert (not (not (forall ((X Int) (Y Int) (Z Int) (R tptp.list)) (or (>= (+ X (* (- 1) Y)) 0) (>= (+ X Y (* (- 1) Z)) 1) (not (tptp.fib_sorted (tptp.mycons Y (tptp.mycons Z R)))) (tptp.fib_sorted (tptp.mycons X (tptp.mycons Y (tptp.mycons Z R)))))))))
(assert (not (or (>= (+ 1 (* (- 1) 2)) 0) (>= (+ 1 2 (* (- 1) 4)) 1) (not (tptp.fib_sorted (tptp.mycons 2 (tptp.mycons 4 tptp.nil)))) (tptp.fib_sorted (tptp.mycons 1 (tptp.mycons 2 (tptp.mycons 4 tptp.nil)))))))
(check-sat)
(exit)
