(set-logic ALL)
(declare-fun x () String)
(declare-fun y () String)
(declare-fun z () Int)
(assert (not (not (= (str.len (str.substr (str.++ x x) 1 (+ (- 1) (* 2 (str.len x))))) 0))))
(assert (not (not (= (str.len (str.++ x x)) (str.len (str.++ (str.substr (str.++ x x) 0 1) (str.substr (str.++ x x) 1 (+ (- 1) (* 2 (str.len x))))))))))
(assert (not (not (= (str.len (str.++ x x)) (* 2 (str.len x))))))
(assert (not (not (= (str.len (str.substr (str.++ x x) 1 (+ (- 1) (* 2 (str.len x))))) (+ (* (- 1) (str.len (str.substr (str.++ x x) 0 1))) (str.len (str.++ (str.substr (str.++ x x) 0 1) (str.substr (str.++ x x) 1 (+ (- 1) (* 2 (str.len x)))))))))))
(assert (not (not (not (>= (str.len (str.substr (str.++ x x) 0 1)) 2)))))
(assert (not (not (>= (str.len x) 1))))
(assert (not false))
(check-sat)
(exit)
