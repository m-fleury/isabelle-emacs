unsat
(step t1.c1 (cl (= (> (+ 64 1) 64) true)) :rule trust)
(step t1.c2 (cl (= (<= (- (* 2 (+ 64 1)) (+ (ite (= 0 0) 64 (- 64 (+ 1 (int.log2 0)))) (ite (= 0 0) 64 (- 64 (+ 1 (int.log2 0)))))) 2) true)) :rule trust)
(step t1.c3 (cl (= 63 (+ 1 (- 64 2)))) :rule trust)
(step t1.main (cl (= (extract 64 2 (bvmul (concat (@bv 0 64) x2) (concat (@bv 0 64) y2))) (@bv 0 63))) :rule rare_rewrite :premises (t1.c1 t1.c2 t1.c3) :args ("bv-extract-mult-leading-bit" 64 2 0 64 x2 0 64 y2 63))
