(set-logic QF_AUF)
(declare-sort Index 0)
(declare-sort Element 0)
(declare-fun v0 () (Array Index Element))
(declare-fun v1 () Index)
(declare-fun v2 () Index)
(declare-fun v3 () Index)
(declare-fun v4 () Element)
(declare-fun v5 () Element)
(declare-fun v6 () Element)
(assert (not (not (not (= v4 v5)))))
(assert (not (not (= (ite (= v2 v3) v4 v6) (ite (= v2 v3) v5 v6)))))
(assert (not (not (= v4 (ite (= v2 v3) v4 v6)))))
(assert (not (not (= v5 (ite (= v2 v3) v5 v6)))))
(assert (not (and (= (ite (= v2 v3) v4 v6) (ite (= v2 v3) v5 v6)) (= v4 (ite (= v2 v3) v4 v6)) (= v5 (ite (= v2 v3) v5 v6)) (not (= v4 v5)))))
(check-sat)
(exit)
