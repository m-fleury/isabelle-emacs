(set-logic ALL)
(declare-fun actionName () String)
(declare-fun actionNamespace () String)
(declare-fun example_key () String)
(declare-fun p0.0.action () Bool)
(declare-fun p0.denies () Bool)
(declare-fun p0.allows () Bool)
(declare-fun p0.neutral () Bool)
(declare-fun p1.0.action () Bool)
(declare-fun p1.0.condition () Bool)
(declare-fun p1.denies () Bool)
(declare-fun p1.allows () Bool)
(declare-fun p1.neutral () Bool)
(assert (not (not (= "" (str.substr (str.substr actionName 1 (+ (- 1) (str.len actionName))) 0 (str.len example_key))))))
(assert (not (not (not (= example_key "")))))
(assert (not (not (= example_key (str.substr (str.substr actionName 1 (+ (- 1) (str.len actionName))) 0 (str.len example_key))))))
(assert (not false))
(check-sat)
(exit)
