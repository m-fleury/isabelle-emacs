unsat
(
(assume a0 false)
(step t0 (cl (not false)) :rule false)
(step t1 (cl (or p) (not p)) :rule or_neg :args(0))
(step t2 (cl (or p q (or r s) t) (not p)) :rule or_neg :args(0))
(step t3 (cl (or p q (or r s) t) (not q)) :rule or_neg :args(1))
(step t4 (cl (or p q (or r s) t) (not (or r s))) :rule or_neg :args(2))
(step t5 (cl (or p q r (or s t)) (not (or s t))) :rule or_neg :args(3))
(step t6 (cl) :rule resolution :premises (a0 t0))
)
